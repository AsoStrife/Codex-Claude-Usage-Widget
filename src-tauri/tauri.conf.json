{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "height": 420,
        "width": 380,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "title": "AI Usage Widget",
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "productName": "AI Usage Widget",
  "version": "0.1.0",
  "identifier": "com.asostrife.ai-usage-widget"
}
